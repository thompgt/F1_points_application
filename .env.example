# F1 Points Calculator - Environment Configuration
# Copy this file to .env and customize for your environment:
#   cp .env.example .env

# ============================================================================
# Application
# ============================================================================
APP_NAME=F1 Points Calculator
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# ============================================================================
# Server
# ============================================================================
HOST=0.0.0.0
PORT=8000

# ============================================================================
# Database
# ============================================================================
# MySQL (default). Start it with `docker compose up -d`, then seed it once with
# `python scripts/seed_mysql.py`. These values must match docker-compose.yml,
# which reads them from this file.
MYSQL_DATABASE=f1
MYSQL_USER=f1user
MYSQL_PASSWORD=f1pass
MYSQL_ROOT_PASSWORD=f1rootpass
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://f1user:f1pass@localhost:3306/f1

# SQLite (fallback - no server required)
# DATABASE_URL=sqlite:///cache.db

# PostgreSQL / Supabase
# DATABASE_URL=postgresql://user:password@localhost:5432/f1_calculator
# DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ============================================================================
# Redis Cache (Optional - improves performance)
# ============================================================================
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ============================================================================
# Rate Limiting
# ============================================================================
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=10

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# Allow all origins (development only). Credentials are only enabled when
# explicit origins are listed.
CORS_ORIGINS=*
# CORS_ORIGINS=https://myapp.com,https://www.myapp.com

# ============================================================================
# AI Season Simulation (local Ollama, model fixed to llama3.1:8b)
# ============================================================================
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Optional integrations
# ============================================================================
# Opt-in: fetch qualifying telemetry from the external fastf1 timing API
# ENABLE_FASTF1_QUALI_GAP=false

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Security
# ============================================================================
# IMPORTANT: Change this in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ============================================================================
# Data & Export
# ============================================================================
# Directory holding the seed CSVs (read by scripts/seed_mysql.py)
DATA_DIR=.
EXPORT_DIR=exports
MAX_EXPORT_SIZE_MB=50
