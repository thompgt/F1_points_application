# Direct dependencies with the ranges that are actually intended.
#
# requirements.txt is the resolved, fully pinned lock generated from this file.
# Edit here, then regenerate:
#
#     pip install pip-tools
#     pip-compile requirements.in -o requirements.txt
#
# Nothing floats in requirements.txt on purpose. Every dependency used to be
# unpinned, and CI caught exactly why: a newer fastapi changed router internals
# and prometheus-fastapi-instrumentator started raising
# "'_IncludedRouter' object has no attribute 'path'" on every health-probe test,
# on a commit that changed no application code.

# --- Web framework ---
fastapi>=0.141,<1
uvicorn[standard]>=0.30,<0.39
# Listed explicitly because middleware.py imports from it directly. 1.x is the
# floor: prometheus-fastapi-instrumentator 8.x requires starlette>=1.0, and
# fastapi only stopped capping starlette below 1.0 at 0.141.
starlette>=1.0,<2
python-multipart>=0.0.9
jinja2>=3.1.2

# --- Validation and settings ---
pydantic>=2.5,<3
pydantic-settings>=2.0,<3
python-dotenv>=1.0

# --- Data and charts ---
pandas>=2.1,<3
plotly>=5.17,<7
kaleido>=0.2          # static image export for the PDF report
Pillow>=10.0

# --- Persistence ---
SQLAlchemy>=2.0,<3
alembic>=1.11.1
PyMySQL>=1.1           # MySQL driver (mysql+pymysql:// URLs)
cryptography>=42.0     # required by PyMySQL for MySQL 8 caching_sha2_password
psycopg[binary]>=3.1
redis>=4.5

# --- Season simulator: RAG, scraping, PDF ---
chromadb>=1.0,<2       # 0.4 -> 1.0 was a breaking API change; do not widen
beautifulsoup4>=4.12
requests>=2.31
wikipedia-api>=0.6
reportlab>=4.0

# --- Observability ---
prometheus-client>=0.21
# 8.1 is the floor, not 7.x: older releases read router internals that fastapi
# 0.121 renamed, and every health-probe test dies with
# "'_IncludedRouter' object has no attribute 'path'".
prometheus-fastapi-instrumentator>=8.1,<9

# --- Dev and test ---
pytest>=7.4
httpx>=0.24            # required by fastapi.testclient.TestClient
ruff>=0.15             # config in ruff.toml, enforced by CI
